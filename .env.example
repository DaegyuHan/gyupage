# 이 파일을 .env.local 로 복사해서 키를 넣으세요. (.env.local 은 git 에 올라가지 않아요)
# Vercel 에서는 Project Settings > Environment Variables 에 같은 이름으로 넣으면 돼요.

# 해외 축구 (프리미어리그, 라리가, 분데스리가, 챔피언스리그) - https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# 국내 축구 (K리그1, K리그2) - https://dashboard.api-football.com
API_FOOTBALL_KEY=

# 메이플스토리 - https://openapi.nexon.com (애플리케이션 만들고 API 키 발급)
NEXON_API_KEY=
# 메이플스토리 캐릭터 이름
MAPLE_CHARACTER=

# LoL - https://developer.riotgames.com (Personal API Key 추천)
RIOT_API_KEY=
# Riot ID (게임이름#태그)
RIOT_ID=

# Steam - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Steam 프로필 주소 또는 17자리 SteamID
STEAM_ID=

# Claude API (Daily CS) - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# DB (Neon) - https://neon.tech
DATABASE_URL=
# 로그인 비밀번호 / 로그인 쿠키 서명용 긴 무작위 문자열
APP_PASSWORD=
AUTH_SECRET=

# 아이폰 위젯(Scriptable) 전용 토큰 (긴 무작위 문자열)
WIDGET_TOKEN=
